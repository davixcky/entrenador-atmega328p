---
// Estructura comun: cabecera con menu e idioma, contenido y pie.
import '../styles/sitio.css'
import { PAGINAS, REPO, T, base, rutaEquivalente, url, type Idioma, type Pagina } from '../i18n'

interface Props {
  idioma: Idioma
  titulo?: string
  pagina?: Pagina
  ancho?: boolean
}
const { idioma, titulo, pagina, ancho = false } = Astro.props
const t = T[idioma]
const tituloCompleto = titulo ? `${titulo} · ${t.titulo}` : t.titulo
const menu = (Object.keys(PAGINAS) as Pagina[]).map((p) => ({ pagina: p, href: url(idioma, p), texto: t.menu[p] }))
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={t.descripcion} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang={idioma === 'es' ? 'en' : 'es'} href={rutaEquivalente(idioma, pagina)} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={t.descripcion} />
    <meta property="og:image" content={new URL(`${base}/archivos/render-arriba.png`, Astro.site).href} />
  </head>
  <body>
    <header class="cabecera">
      <div class="cabecera-dentro">
        <a class="marca" href={url(idioma)}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M2 7h3M2 11h3M2 15h3M19 7h3M19 11h3M19 15h3" /></svg>
          <span>{t.titulo}</span>
        </a>
        <nav aria-label={idioma === 'es' ? 'Principal' : 'Main'}>
          {menu.map((m) => <a href={m.href} aria-current={m.pagina === pagina ? 'page' : undefined}>{m.texto}</a>)}
        </nav>
        <div class="acciones">
          <a class="idioma" href={rutaEquivalente(idioma, pagina)} hreflang={idioma === 'es' ? 'en' : 'es'}>{t.otroIdioma}</a>
          <a class="github" href={REPO} aria-label="GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
          </a>
        </div>
      </div>
    </header>
    <main class={ancho ? 'contenido ancho' : 'contenido'}>
      <slot />
    </main>
    <footer class="pie">
      <p>{t.pie}</p>
      <p><a href={REPO}>{REPO.replace('https://', '')}</a></p>
    </footer>
  </body>
</html>
