---
// Paginas de documentos (los .md del repositorio) y del esquematico, en cada idioma.
import { getEntry, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { IDIOMAS, PAGINAS, REPO, T, archivo, type Idioma, type Pagina } from '../../i18n'

export function getStaticPaths() {
  return IDIOMAS.flatMap((lang) =>
    (Object.keys(PAGINAS) as Pagina[]).map((pagina) => ({ params: { lang, pagina: PAGINAS[pagina].ruta[lang] }, props: { pagina } })),
  )
}

const idioma = Astro.params.lang as Idioma
const { pagina } = Astro.props as { pagina: Pagina }
const t = T[idioma]
const id = PAGINAS[pagina].doc?.[idioma]
const entrada = id ? await getEntry('docs', id) : undefined
if (id && !entrada) throw new Error(`Falta el documento ${id}`)
const { Content, headings } = entrada ? await render(entrada) : { Content: null, headings: [] }
const indice = headings.filter((h) => h.depth === 2)
const soloEspanol = idioma === 'en' && pagina === 'biblioteca'
---

<Base idioma={idioma} titulo={t.menu[pagina]} pagina={pagina}>
  {
    pagina === 'esquematico' ? (
      <article class="documento">
        <h1>{t.esq.titulo}</h1>
        <p>{t.esq.intro}</p>
        <p class="botones">
          <a class="boton primario" href={archivo('esquematico.pdf')}>{t.esq.abrir}</a>
          <a class="boton" href={archivo('CONEXIONES.pdf')}>{t.esq.conexiones}</a>
          <a class="boton" href={`${REPO}/tree/main/kicad`}>KiCad</a>
        </p>
        <a class="esquematico" href={archivo('esquematico.pdf')}>
          <img src={archivo('esquematico.png')} alt={t.esq.titulo} width="2481" height="1754" />
        </a>
        <p class="nota">{t.esq.nota}</p>
        <h2>{t.esq.bloques}</h2>
        <dl class="bloques">
          {t.esq.lista.map(([nombre, texto]) => (
            <>
              <dt>{nombre}</dt>
              <dd>{texto}</dd>
            </>
          ))}
        </dl>
      </article>
    ) : (
      <div class="con-indice">
        {indice.length > 2 && (
          <nav class="indice" aria-label={t.contenido}>
            <p>{t.contenido}</p>
            <ul>
              {indice.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <article class="documento">
          {soloEspanol && <p class="nota">{t.soloEspanol}</p>}
          {Content && <Content />}
          <p class="fuente">
            <a href={`${REPO}/blob/main/${id}.md`}>{t.verEnGithub}</a>
          </p>
        </article>
      </div>
    )
  }
</Base>
