---
import Base from '../../layouts/Base.astro'
import { IDIOMAS, T, archivo, url, type Idioma } from '../../i18n'
import { analizar, ejemplos, generarArduino } from '../../../../app/lenguaje/src/index.ts'

export const getStaticPaths = () => IDIOMAS.map((lang) => ({ params: { lang } }))

const idioma = Astro.params.lang as Idioma
const t = T[idioma]
const ti = t.inicio

// Ejemplo real, generado con la libreria del lenguaje al construir el sitio
const ejemplo = ejemplos[0]
const sketch = generarArduino(analizar(ejemplo.codigo), { nombre: ejemplo.nombre })
  .split('\n')
  .filter((l) => !l.startsWith('// Generado') && !l.startsWith('// Necesita'))
  .join('\n')

const diagrama =
  idioma === 'es'
    ? `PC (app) ──USB──> Arduino Uno (puente-uno)
                    │ ISP D10–D13: grabar firmware
                    │ serie D2/D3: programas y monitor
                    ▼
            ATmega328P (firmware bloques)
            máquina virtual + biblioteca Entrenador
                    │
    LEDs · displays · pot · DIP · botones`
    : `PC (app) ──USB──> Arduino Uno (puente-uno)
                    │ ISP D10–D13: flash firmware
                    │ serial D2/D3: programs and monitor
                    ▼
            ATmega328P (bloques firmware)
            virtual machine + Entrenador library
                    │
    LEDs · displays · pot · DIP · buttons`

const fotos = ['01-montaje-protoboard.jpg', '03-contador-00-a-10.jpg', '06-app-monitor-placa.png']
---

<Base idioma={idioma} ancho>
  <section class="portada">
    <div class="portada-texto">
      <p class="etiqueta">{ti.etiqueta}</p>
      <h1>{t.titulo}</h1>
      <p class="lema">{ti.lema}</p>
      <div class="botones">
        <a class="boton primario" href={url(idioma, 'guia')}>{ti.empezar}</a>
        <a class="boton" href={url(idioma, 'esquematico')}>{ti.esquematico}</a>
      </div>
    </div>
    <figure class="portada-imagen">
      <img src={archivo('05-app-diagrama-codigo.png')} alt={idioma === 'es' ? 'La app con el diagrama y el código del mismo programa' : 'The app showing the diagram and the code of the same program'} width="1440" height="900" />
    </figure>
  </section>

  <section>
    <h2>{ti.queEs}</h2>
    <div class="tarjetas">
      {ti.piezas.map(([titulo, texto]) => (
        <article class="tarjeta">
          <h3>{titulo}</h3>
          <p>{texto}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="dos-columnas">
    <div>
      <h2>{ti.app}</h2>
      <p>{ti.appTexto}</p>
    </div>
    <div>
      <h2>{ti.comoFunciona}</h2>
      <pre class="diagrama"><code>{diagrama}</code></pre>
    </div>
  </section>

  <section>
    <h2>{ti.generado}</h2>
    <p>{ti.generadoTexto}</p>
    <div class="comparar">
      <figure>
        <figcaption>{ti.programa}</figcaption>
        <pre><code>{ejemplo.codigo.trim()}</code></pre>
      </figure>
      <figure>
        <figcaption>{ti.sketch}</figcaption>
        <pre><code>{sketch.trim()}</code></pre>
      </figure>
    </div>
    <p><a href={url(idioma, 'lenguaje')}>{t.menu.lenguaje} →</a> · <a href={url(idioma, 'biblioteca')}>{t.menu.biblioteca} →</a></p>
  </section>

  <section>
    <h2>{ti.fotos}</h2>
    <div class="galeria">
      {fotos.map((f) => (
        <figure>
          <a href={archivo(f)}><img src={archivo(f)} alt={ti.pies[f]} loading="lazy" /></a>
          <figcaption>{ti.pies[f]}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section>
    <h2>{ti.descargas}</h2>
    <ul class="descargas">
      {ti.archivos.map(([nombre, texto]) => (
        <li><a href={archivo(nombre)}>{texto}</a></li>
      ))}
    </ul>
  </section>
</Base>
