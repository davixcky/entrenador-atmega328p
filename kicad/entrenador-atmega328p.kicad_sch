	(text "C5 junto a VCC (7), C6 junto a AVCC (20),\nC7 en AREF (21). Los dos GND (8 y 22) a tierra.\nC5/C6 pegados al chip y cristal junto a pines 9-10:\nreducen el ruido del multiplexado."
		(exclude_from_sim no)
		(at 17.78 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9c6580f6-8f87-59a6-94d6-fdafb21bc53f")
	)
	(text "Equivalencias Arduino:\nPD2..PD7 = D2..D7    PB0..PB5 = D8..D13\nPC0..PC4 = A0..A4    PD0/PD1 = RX/TX (FTDI)"
		(exclude_from_sim no)
		(at 17.78 106.68 0)
		(effects
