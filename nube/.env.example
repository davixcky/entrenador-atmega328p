# Variables para la app web (Vite + @supabase/supabase-js). Copiar a .env.local.
# Local: URL y clave salen de `npm run llaves` (API_URL y ANON_KEY).
# Alojado: Supabase Dashboard > Project Settings > API (Project URL y anon/publishable key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=pegar-aqui-la-clave-anon
VITE_DISPOSITIVO=entrenador-1
# Opcional: URL del proyecto alojado, para el botón "Alojado" de Nube > Conexión
# (la clave se pega en la app y queda guardada por URL)
VITE_SUPABASE_URL_ALOJADO=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY_ALOJADO=pegar-aqui-la-clave-anon-del-alojado
# Lo escribe solo: python3 nube/configurar.py
